# SMTP is the recommended production transport; it also works with self-hosted
# open-source mail servers such as Mailu, Mailcow, or Postal.
EMAIL_TRANSPORT=smtp
EMAIL_SENDER=
EMAIL_RECIPIENT=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# Mount this directory as persistent storage in production.
DATA_DIR=data
ATTENDANCE_CSV=data/attendance.csv
EMAIL_LOG_PATH=data/email_log.json

# To use Gmail API instead, set EMAIL_TRANSPORT=gmail and configure these.
GMAIL_SENDER=
GMAIL_RECIPIENT=
GOOGLE_CLIENT_SECRET_FILE=credentials/client_secret.json
GOOGLE_TOKEN_FILE=credentials/token.json
